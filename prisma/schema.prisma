generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user") // admin, user, auditor
  organization  String?
  accounts      Account[]
  sessions      Session[]
  evidence      Evidence[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Evidence {
  id          String   @id @default(cuid())
  name        String
  description String?
  framework   String
  controlId   String
  type        String
  mimeType    String
  size        Int
  url         String?  // Path/URL to file
  status      String   // pending, analyzing, verified, failed
  analysis    String?  // JSON string of analysis result
  uploadedAt  DateTime @default(now())
  verifiedAt  DateTime?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}
